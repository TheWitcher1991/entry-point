# ─── Database ───
POSTGRES_USER=entrypoint
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=entrypoint

# ─── Redis ───
REDIS_PASSWORD=change-me-to-another-password

# ─── Backend ───
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
SECRET_KEY=generate-a-long-random-string-with-openssl-rand-64
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["https://talentpot.ru"]

# ─── SMTP (Email) ───
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USERNAME=noreply@talentpot.ru
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@talentpot.ru
SMTP_USE_TLS=true

# ─── Nginx ───
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
